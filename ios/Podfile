# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

# React Native 0.87's prebuilt React Core ships React as a DYNAMIC framework,
# links it, and then never embeds it into the .app — the CocoaPods embed script
# only copies ReactNativeDependencies and hermesvm. The app builds fine and then
# dies at launch with:
#   dyld: Library not loaded: @rpath/React.framework/React
# Building React Core from source links it statically, so there is nothing to
# embed. Costs a slower first build; buys an app that actually starts.
ENV['RCT_USE_PREBUILT_RNCORE'] = '0'

platform :ios, min_ios_version_supported
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'AIPromptGallery' do
  config = use_native_modules!

  # Firebase's Swift pods (FirebaseCoreInternal, FirebaseFirestore) import
  # these Objective-C/C++ pods, which do not define modules by default. As
  # static libraries that fails to compile, so opt just these into module maps
  # rather than flipping the whole project to use_frameworks!, which would
  # change how every other native module links.
  pod 'GoogleUtilities', :modular_headers => true
  pod 'FirebaseCore', :modular_headers => true
  pod 'FirebaseCoreInternal', :modular_headers => true
  pod 'FirebaseCoreExtension', :modular_headers => true
  pod 'FirebaseFirestoreInternal', :modular_headers => true

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )
    installer.aggregate_targets.each do |target|
      target.xcconfigs.each do |config_name, config_file|
        config_file.other_linker_flags[:frameworks]&.delete("FirebaseFirestoreInternal")
        config_file.other_linker_flags[:weak_frameworks]&.delete("FirebaseFirestoreInternal")
        xcconfig_path = target.xcconfig_path(config_name)
        config_file.save_as(xcconfig_path)
      end
    end
  end
end

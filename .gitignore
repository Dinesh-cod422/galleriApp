# Firebase credentials — NEVER commit these
*serviceAccount*.json
*-firebase-adminsdk-*.json
service-account*.json
.firebase/
firestore-debug.log
firebase-debug.log
ui-debug.log
.env
.env.*
!.env.example

# Built image renditions — cloud-only, archived at ~/Desktop/prompt-images/
# Never commit these: 64MB of binaries whose home is the CDN, not the repo.
# hosting/manifest.json IS tracked — it is the record of what is live, and the
# predeploy guard reads it to refuse a deploy that would empty the site.
hosting/prompts/

# Release signing — the upload key and its password must never be committed.
*.jks
android/keystore.properties

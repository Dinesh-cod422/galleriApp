{
  "name": "AIPromptGallery",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "lint": "eslint . --ext .ts,.tsx,.js",
    "start": "react-native start",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "test:coverage": "jest --coverage",
    "circular": "npx --yes madge@8 --circular --extensions ts,tsx src",
    "verify": "npm run typecheck && npm run lint && npm run circular && npm test",
    "hosting:restore": "cp -R ~/Desktop/prompt-images/hosting-build/prompts hosting/prompts",
    "hosting:check": "node tools/seed/assert-hosting-ready.mjs",
    "hosting:deploy": "npx firebase-tools@14 deploy --only hosting --project notesapp-ed63a"
  },
  "dependencies": {
    "@d11/react-native-fast-image": "^8.13.0",
    "@dineshcodes/responsive-react-native-ui": "^2.0.0",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@react-native-clipboard/clipboard": "^1.16.3",
    "@react-native-firebase/app": "^23.8.8",
    "@react-native-firebase/firestore": "^23.8.8",
    "@react-native/new-app-screen": "0.87.1",
    "@react-navigation/bottom-tabs": "^7.18.18",
    "@react-navigation/native": "^7.3.18",
    "@react-navigation/native-stack": "^7.18.10",
    "@shopify/flash-list": "^2.3.2",
    "@tanstack/react-query": "^5.102.8",
    "react": "19.2.3",
    "react-native": "0.87.1",
    "react-native-gesture-handler": "^3.2.1",
    "react-native-haptic-feedback": "^3.0.0",
    "react-native-linear-gradient": "^2.8.3",
    "react-native-mmkv": "^4.3.2",
    "react-native-nitro-modules": "^0.37.1",
    "react-native-reanimated": "^4.6.0",
    "react-native-safe-area-context": "^5.5.2",
    "react-native-screens": "^4.27.0",
    "react-native-svg": "^15.15.5",
    "react-native-worklets": "^0.12.2",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.87.1",
    "@react-native/eslint-config": "0.87.1",
    "@react-native/jest-preset": "0.87.1",
    "@react-native/metro-config": "0.87.1",
    "@react-native/typescript-config": "0.87.1",
    "@tanstack/eslint-plugin-query": "^5.102.8",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "babel-plugin-module-resolver": "^5.0.3",
    "eslint": "^8.19.0",
    "eslint-import-resolver-typescript": "^3.10.1",
    "eslint-plugin-import": "^2.32.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-test-renderer": "19.2.3",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">= 22.11.0"
